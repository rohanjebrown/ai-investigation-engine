# NON-SECRET one-time Cloud Run settings. Fill operator selections before use.
# Do not use this file to store passwords/tokens/API keys.
DB_CONNECTION_MODE=cloudsql_socket
DB_HOST=/cloudsql/ai-investigation-engine-512912:europe-west3:investigation-postgres
DB_PORT=5432
DB_NAME=REPLACE_WITH_EXISTING_DATABASE
DB_USER=REPLACE_WITH_EXISTING_DATABASE_USER
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=30000
GEMINI_GENERATION_MODEL=
SERVING_CHUNKING_CONFIGURATION_ID=
FORWARDED_ALLOW_IPS=*
ADMIN_REQUIRE_HTTPS=true
INVESTIGATION_ENABLED=false
# DB_PASSWORD, GEMINI_API_KEY and ADMIN_API_TOKEN are Secret Manager references,
# configured separately using existing secret names/versions (never values here).
