# Development only. Settings automatically load .env from the working directory.
# Existing process variables take precedence; values are literal (no interpolation).
# Start your existing Cloud SQL Auth Proxy separately on this loopback endpoint.
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=your_database
DB_USER=your_database_user
DB_PASSWORD="replace_with_your_database_password"
DB_CONNECTION_MODE=proxy
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=30000
# Cloud Run uses cloudsql_socket and DB_HOST=/cloudsql/PROJECT:REGION:INSTANCE,
# DB_PORT=5432, with credentials supplied through Secret Manager at runtime.

# Required when using either Gemini adapter or starting the HTTP RAG application.
# Never enables live tests automatically; do not commit the populated .env.
GEMINI_API_KEY=
GEMINI_EMBEDDING_BATCH_SIZE=25
GEMINI_EMBEDDING_BATCH_TOKEN_LIMIT=32768

# Explicit operator selections; blank values keep database-only commands usable,
# but the HTTP RAG application will refuse startup. Model selection is not final.
# Proposed development model: gemini-3.6-flash (availability/quota not live-verified).
GEMINI_GENERATION_MODEL=
# Existing persisted configuration ID; no profile creation or indexing at startup.
SERVING_CHUNKING_CONFIGURATION_ID=
GENERATION_TIMEOUT_SECONDS=30
GENERATION_MAX_ATTEMPTS=2
GENERATION_MAX_OUTPUT_TOKENS=1024
RAG_MAX_EVIDENCE=5
RAG_MAX_CONTEXT_CHARS=12000

# Multi-step Gemini investigations are disabled unless explicitly enabled.
# Keep disabled on public deployments until per-user quota protections exist.
INVESTIGATION_ENABLED=false
INVESTIGATION_MAX_TURNS=6
INVESTIGATION_MAX_SEARCH_CALLS=5
INVESTIGATION_MAX_RESULTS_PER_SEARCH=5
INVESTIGATION_MAX_ACCUMULATED_EVIDENCE=15
INVESTIGATION_MAX_CONTEXT_CHARS=24000
INVESTIGATION_MAX_GENERATION_REQUESTS=6
INVESTIGATION_MAX_EMBEDDING_REQUESTS=5
INVESTIGATION_MAX_OUTPUT_TOKENS=1024
INVESTIGATION_TIMEOUT_SECONDS=120

# Server-owned retrieval; semantic preserves the existing experimental baseline.
RETRIEVAL_MODE=semantic
SEMANTIC_CANDIDATE_LIMIT=20
KEYWORD_CANDIDATE_LIMIT=20
RRF_K=60

# Optional administrator document management. Use a random token of at least
# 32 ASCII characters; configure HTTPS enforcement on public deployments.
# The token is never stored by the browser and must never be committed here.
ADMIN_API_TOKEN=
ADMIN_PRINCIPAL_ID=administrator
ADMIN_REQUIRE_HTTPS=true
MAX_UPLOAD_BYTES=10485760
MAX_EXTRACTED_TEXT_CHARS=1000000
MAX_DOCX_UNCOMPRESSED_BYTES=52428800
MAX_PDF_PAGES=500
MAX_INDEX_EMBEDDINGS_PER_REQUEST=2
CHUNKING_TOKENIZER_PATH=artifacts/tokenizers/voyage-4/tokenizer.json
